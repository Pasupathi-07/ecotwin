# EcoTwin AI — Environment Configuration Example
# No paid API keys or external cloud credentials are required.

# Server Port (Default: 3000 for integrated Express + Vite runtime)
PORT=3000

# Optional API Base URL for Frontend (Leave empty to use same-origin /api routes,
# or set to http://127.0.0.1:8000 when running the standalone Python FastAPI server)
VITE_API_BASE_URL=""

# Local Storage Paths (kept outside public static directories)
ECOTWIN_DATA_DIR="./data"
ECOTWIN_DB_PATH="./data/ecotwin.sqlite"
ECOTWIN_MAX_UPLOAD_MB=10

# Reference Air Quality Standard ("WHO_2021" or "CPCB_NAAQS")
VITE_DEFAULT_AQ_STANDARD="CPCB_NAAQS"
